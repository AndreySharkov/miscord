@{
    Layout = null;
    ViewData["Title"] = "Admin Dashboard";
    var totalUsers = ViewData["TotalUsers"] as int? ?? 0;
    var totalServers = ViewData["TotalServers"] as int? ?? 0;
    var totalMessages = ViewData["TotalMessages"] as int? ?? 0;
    var totalChannels = ViewData["TotalChannels"] as int? ?? 0;
    var servers = ViewData["ServersList"] as IEnumerable<Miscord.Data.Models.Server> ?? new List<Miscord.Data.Models.Server>();
    var users = ViewData["UsersList"] as IEnumerable<Miscord.Data.Models.ApplicationUser> ?? new List<Miscord.Data.Models.ApplicationUser>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Miscord Admin - @ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: 'gg sans', 'Noto Sans', 'Helvetica Neue', Helvetica, Arial, sans-serif;
            background-color: #313338;
            color: #dbdee1;
        }
        .admin-nav {
            background-color: #1e1f22;
            height: 60px;
            display: flex;
            align-items: center;
            padding: 0 40px;
            justify-content: space-between;
            box-shadow: 0 1px 0 rgba(0,0,0,0.2);
            position: sticky;
            top: 0;
            z-index: 100;
        }
        .admin-nav-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            font-weight: 700;
            color: #fff;
            text-decoration: none;
            font-size: 20px;
        }
        .admin-nav-actions {
            display: flex;
            gap: 20px;
        }
        .admin-nav-link {
            color: #b5bac1;
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            transition: color 0.15s;
        }
        .admin-nav-link:hover { color: #fff; }
        
        .admin-dashboard {
            padding: 40px;
            max-width: 1200px;
            margin: 0 auto;
        }
        /* (rest of the previous styles moved here) */
        .admin-header { margin-bottom: 32px; }
        .admin-title { font-size: 28px; font-weight: 700; color: #fff; margin-bottom: 8px; }
        .admin-subtitle { color: #949ba4; font-size: 15px; }
        .admin-alert { padding: 12px 16px; border-radius: 4px; margin-bottom: 24px; font-weight: 500; font-size: 14px; }
        .admin-alert.success { background-color: rgba(35, 165, 90, 0.15); color: #23a55a; border: 1px solid #23a55a; }
        .admin-alert.danger { background-color: rgba(242, 63, 66, 0.15); color: #f23f42; border: 1px solid #f23f42; }
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 32px; }
        .stat-card { background-color: #2b2d31; border: 1px solid #1e1f22; border-radius: 8px; padding: 20px; display: flex; align-items: center; gap: 16px; }
        .stat-icon { font-size: 28px; width: 52px; height: 52px; background-color: #313338; border-radius: 8px; display: flex; align-items: center; justify-content: center; }
        .stat-info { display: flex; flex-direction: column; }
        .stat-value { font-size: 24px; font-weight: 700; color: #fff; }
        .stat-label { font-size: 12px; color: #949ba4; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 2px; }
        .admin-sections { display: flex; flex-direction: column; gap: 32px; }
        .section-card { background-color: #2b2d31; border: 1px solid #1e1f22; border-radius: 8px; padding: 24px; }
        .section-title { font-size: 18px; font-weight: 600; color: #fff; margin-bottom: 20px; }
        .table-container { overflow-x: auto; }
        .admin-table { width: 100%; border-collapse: collapse; text-align: left; }
        .admin-table th, .admin-table td { padding: 12px 16px; font-size: 14px; border-bottom: 1px solid #1e1f22; }
        .admin-table th { color: #949ba4; text-transform: uppercase; font-size: 11px; letter-spacing: 0.5px; font-weight: 600; }
        .admin-table tbody tr:hover { background-color: #313338; }
        .dimmed { color: #949ba4; font-family: monospace; }
        .empty-state { text-align: center; color: #949ba4; font-style: italic; }
        .admin-btn-danger { background-color: #da373c; color: #fff; border: none; border-radius: 4px; padding: 6px 12px; font-size: 12px; font-weight: 500; cursor: pointer; transition: background-color 0.15s; }
        .admin-btn-danger:hover { background-color: #a92b2f; }
    </style>
</head>
<body>

<nav class="admin-nav">
    <a href="/" class="admin-nav-brand">
        <img src="/gurimilishi.png" width="32" height="32" alt="Logo" />
        <span>Miscord Control Center</span>
    </a>
    <div class="admin-nav-actions">
        <a href="/" class="admin-nav-link">Return to App</a>
        <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline;">
            <button type="submit" class="admin-nav-link" style="background:none; border:none; cursor:pointer; font-family:inherit;">Logout</button>
        </form>
    </div>
</nav>

<div class="admin-dashboard">
    <div class="admin-header">
        <h1 class="admin-title">System Administration Panel</h1>
        <p class="admin-subtitle">Monitoring stats for <strong>admin@miscord.com</strong></p>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="admin-alert success">
            @TempData["Message"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="admin-alert danger">
            @TempData["Error"]
        </div>
    }

    <!-- Stat Grid -->
    <div class="stats-grid">
        <div class="stat-card">
            <span class="stat-icon">👥</span>
            <div class="stat-info">
                <span class="stat-value">@totalUsers</span>
                <span class="stat-label">Total Registered Users</span>
            </div>
        </div>
        <div class="stat-card">
            <span class="stat-icon">🌐</span>
            <div class="stat-info">
                <span class="stat-value">@totalServers</span>
                <span class="stat-label">Active Servers</span>
            </div>
        </div>
        <div class="stat-card">
            <span class="stat-icon">💬</span>
            <div class="stat-info">
                <span class="stat-value">@totalMessages</span>
                <span class="stat-label">Total Messages</span>
            </div>
        </div>
        <div class="stat-card">
            <span class="stat-icon">#</span>
            <div class="stat-info">
                <span class="stat-value">@totalChannels</span>
                <span class="stat-label">Active Channels</span>
            </div>
        </div>
    </div>

    <!-- Management Sections -->
    <div class="admin-sections">
        <!-- Servers Section -->
        <div class="section-card">
            <h2 class="section-title">Active Server Management</h2>
            <div class="table-container">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Server ID</th>
                            <th>Name</th>
                            <th>Owner</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var server in servers)
                        {
                            <tr>
                                <td>@server.Id</td>
                                <td style="font-weight: 600;">@server.Name</td>
                                <td>@(server.Owner?.Nickname ?? server.Owner?.UserName ?? "Unknown Owner")</td>
                                <td>
                                    <form asp-controller="Admin" asp-action="DeleteServer" method="post" onsubmit="return confirm('Are you sure you want to delete this server permanently? This action cannot be undone.');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="serverId" value="@server.Id" />
                                        <button type="submit" class="admin-btn-danger">Delete Server</button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (!servers.Any())
                        {
                            <tr>
                                <td colspan="4" class="empty-state">No servers found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Users Section -->
        <div class="section-card">
            <h2 class="section-title">User Accounts Overview</h2>
            <div class="table-container">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>User ID</th>
                            <th>Username</th>
                            <th>Email</th>
                            <th>Nickname</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in users)
                        {
                            <tr>
                                <td class="dimmed">@user.Id</td>
                                <td style="font-weight: 600;">@user.UserName</td>
                                <td>@user.Email</td>
                                <td>@(user.Nickname ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

</body>
</html>
