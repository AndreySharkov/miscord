@{
    ViewData["Title"] = "Admin Dashboard";
    var totalUsers = ViewData["TotalUsers"] as int? ?? 0;
    var totalServers = ViewData["TotalServers"] as int? ?? 0;
    var totalMessages = ViewData["TotalMessages"] as int? ?? 0;
    var totalChannels = ViewData["TotalChannels"] as int? ?? 0;
    var servers = ViewData["ServersList"] as IEnumerable<Miscord.Data.Models.Server> ?? new List<Miscord.Data.Models.Server>();
    var users = ViewData["UsersList"] as IEnumerable<Miscord.Data.Models.ApplicationUser> ?? new List<Miscord.Data.Models.ApplicationUser>();
}

<div class="admin-dashboard">
    <div class="admin-header">
        <h1 class="admin-title">System Administration Panel</h1>
        <p class="admin-subtitle">Monitor stats, manage servers, and review users across the platform.</p>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="admin-alert success">
            @TempData["Message"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="admin-alert danger">
            @TempData["Error"]
        </div>
    }

    <!-- Stat Grid -->
    <div class="stats-grid">
        <div class="stat-card">
            <span class="stat-icon">👥</span>
            <div class="stat-info">
                <span class="stat-value">@totalUsers</span>
                <span class="stat-label">Total Registered Users</span>
            </div>
        </div>
        <div class="stat-card">
            <span class="stat-icon">🌐</span>
            <div class="stat-info">
                <span class="stat-value">@totalServers</span>
                <span class="stat-label">Active Servers</span>
            </div>
        </div>
        <div class="stat-card">
            <span class="stat-icon">💬</span>
            <div class="stat-info">
                <span class="stat-value">@totalMessages</span>
                <span class="stat-label">Total Messages</span>
            </div>
        </div>
        <div class="stat-card">
            <span class="stat-icon">#</span>
            <div class="stat-info">
                <span class="stat-value">@totalChannels</span>
                <span class="stat-label">Active Channels</span>
            </div>
        </div>
    </div>

    <!-- Management Sections -->
    <div class="admin-sections">
        <!-- Servers Section -->
        <div class="section-card">
            <h2 class="section-title">Active Server Management</h2>
            <div class="table-container">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Server ID</th>
                            <th>Name</th>
                            <th>Owner</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var server in servers)
                        {
                            <tr>
                                <td>@server.Id</td>
                                <td style="font-weight: 600;">@server.Name</td>
                                <td>@(server.Owner?.Nickname ?? server.Owner?.UserName ?? "Unknown Owner")</td>
                                <td>
                                    <form asp-controller="Admin" asp-action="DeleteServer" method="post" onsubmit="return confirm('Are you sure you want to delete this server permanently? This action cannot be undone.');">
                                        <input type="hidden" name="serverId" value="@server.Id" />
                                        <button type="submit" class="admin-btn-danger">Delete Server</button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (!servers.Any())
                        {
                            <tr>
                                <td colspan="4" class="empty-state">No servers found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Users Section -->
        <div class="section-card">
            <h2 class="section-title">User Accounts Overview</h2>
            <div class="table-container">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>User ID</th>
                            <th>Username</th>
                            <th>Email</th>
                            <th>Nickname</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in users)
                        {
                            <tr>
                                <td class="dimmed">@user.Id</td>
                                <td style="font-weight: 600;">@user.UserName</td>
                                <td>@user.Email</td>
                                <td>@(user.Nickname ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .admin-dashboard {
        padding: 40px;
        background-color: #313338;
        min-height: 100vh;
        color: #dbdee1;
        overflow-y: auto;
    }
    .admin-header {
        margin-bottom: 32px;
    }
    .admin-title {
        font-size: 28px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 8px;
    }
    .admin-subtitle {
        color: #949ba4;
        font-size: 15px;
    }
    .admin-alert {
        padding: 12px 16px;
        border-radius: 4px;
        margin-bottom: 24px;
        font-weight: 500;
        font-size: 14px;
    }
    .admin-alert.success {
        background-color: rgba(35, 165, 90, 0.15);
        color: #23a55a;
        border: 1px solid #23a55a;
    }
    .admin-alert.danger {
        background-color: rgba(242, 63, 66, 0.15);
        color: #f23f42;
        border: 1px solid #f23f42;
    }
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 20px;
        margin-bottom: 32px;
    }
    .stat-card {
        background-color: #2b2d31;
        border: 1px solid #1e1f22;
        border-radius: 8px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 16px;
    }
    .stat-icon {
        font-size: 28px;
        width: 52px;
        height: 52px;
        background-color: #313338;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .stat-info {
        display: flex;
        flex-direction: column;
    }
    .stat-value {
        font-size: 24px;
        font-weight: 700;
        color: #fff;
    }
    .stat-label {
        font-size: 12px;
        color: #949ba4;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-top: 2px;
    }
    .admin-sections {
        display: flex;
        flex-direction: column;
        gap: 32px;
    }
    .section-card {
        background-color: #2b2d31;
        border: 1px solid #1e1f22;
        border-radius: 8px;
        padding: 24px;
    }
    .section-title {
        font-size: 18px;
        font-weight: 600;
        color: #fff;
        margin-bottom: 20px;
    }
    .table-container {
        overflow-x: auto;
    }
    .admin-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
    }
    .admin-table th, .admin-table td {
        padding: 12px 16px;
        font-size: 14px;
        border-bottom: 1px solid #1e1f22;
    }
    .admin-table th {
        color: #949ba4;
        text-transform: uppercase;
        font-size: 11px;
        letter-spacing: 0.5px;
        font-weight: 600;
    }
    .admin-table tbody tr:hover {
        background-color: #313338;
    }
    .dimmed {
        color: #949ba4;
        font-family: monospace;
    }
    .empty-state {
        text-align: center;
        color: #949ba4;
        font-style: italic;
    }
    .admin-btn-danger {
        background-color: #da373c;
        color: #fff;
        border: none;
        border-radius: 4px;
        padding: 6px 12px;
        font-size: 12px;
        font-weight: 500;
        cursor: pointer;
        transition: background-color 0.15s;
    }
    .admin-btn-danger:hover {
        background-color: #a92b2f;
    }
</style>
