@model string
@{
    Layout = "_Layout";
    ViewData["Title"] = "404 - Not Found";
}

<div class="error-page">
    <div class="error-visual">🕵️‍♂️</div>
    <h1 class="error-code">404</h1>
    <h2 class="error-message">Wumpus is lost.</h2>
    <p class="error-desc">We searched everywhere, but we couldn't find the page you're looking for.</p>
    <a href="/" class="landing-btn landing-btn--primary">Go Home</a>
    <div class="request-id">Request ID: @Model</div>
</div>

<style>
    .error-page {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 60px 20px;
        color: #fff;
    }
    .error-visual { font-size: 80px; margin-bottom: 24px; }
    .error-code { font-size: 64px; font-weight: 800; color: #5865f2; margin: 0; }
    .error-message { font-size: 32px; margin-bottom: 12px; }
    .error-desc { color: #b5bac1; max-width: 500px; margin-bottom: 32px; line-height: 1.6; }
    .request-id { margin-top: 40px; font-size: 12px; color: #4e5058; font-family: monospace; }
</style>
