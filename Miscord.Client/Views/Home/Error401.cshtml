@model string
@{
    Layout = "_Layout";
    ViewData["Title"] = "401 - Unauthorized";
}

<div class="error-page">
    <div class="error-visual">🚫</div>
    <h1 class="error-code">401</h1>
    <h2 class="error-message">Halt! Who goes there?</h2>
    <p class="error-desc">You don't have permission to access this area. Maybe you should try logging in again?</p>
    <a href="/Account/Login" class="landing-btn landing-btn--primary">Log In</a>
    <div class="request-id">Request ID: @Model</div>
</div>

<style>
    .error-page {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 60px 20px;
        color: #fff;
    }
    .error-visual { font-size: 80px; margin-bottom: 24px; }
    .error-code { font-size: 64px; font-weight: 800; color: #f23f43; margin: 0; }
    .error-message { font-size: 32px; margin-bottom: 12px; }
    .error-desc { color: #b5bac1; max-width: 500px; margin-bottom: 32px; line-height: 1.6; }
    .request-id { margin-top: 40px; font-size: 12px; color: #4e5058; font-family: monospace; }
</style>
