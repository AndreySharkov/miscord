@model string
@{
    Layout = "_Layout";
    ViewData["Title"] = "500 - Server Error";
}

<div class="error-page">
    <div class="error-visual">🔥</div>
    <h1 class="error-code">500</h1>
    <h2 class="error-message">Something went wrong.</h2>
    <p class="error-desc">Our engineers (and maybe a few hamsters) are working hard to fix this unexpected explosion.</p>
    <a href="/" class="landing-btn landing-btn--primary">Try Again</a>
    <div class="request-id">Request ID: @Model</div>
</div>

<style>
    .error-page {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 60px 20px;
        color: #fff;
    }
    .error-visual { font-size: 80px; margin-bottom: 24px; }
    .error-code { font-size: 64px; font-weight: 800; color: #faa61a; margin: 0; }
    .error-message { font-size: 32px; margin-bottom: 12px; }
    .error-desc { color: #b5bac1; max-width: 500px; margin-bottom: 32px; line-height: 1.6; }
    .request-id { margin-top: 40px; font-size: 12px; color: #4e5058; font-family: monospace; }
</style>
