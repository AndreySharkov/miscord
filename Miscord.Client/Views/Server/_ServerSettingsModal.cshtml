<div id="server-settings-modal" class="cs-backdrop">
    <div class="cs-modal cs-modal--large">
        <button class="cs-close-btn" onclick="closeServerSettingsModal()">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>

        <div class="ss-container">
            <!-- Sidebar Tabs -->
            <div class="ss-sidebar">
                <div class="ss-tab active" onclick="switchSSTab('overview', this)">Overview</div>
                <div class="ss-tab" onclick="switchSSTab('roles', this)">Roles</div>
                <div class="ss-tab" onclick="switchSSTab('members', this)">Members</div>
                <div class="ss-divider"></div>
                <div class="ss-tab ss-tab--danger" onclick="deleteServer()">Delete Server</div>
            </div>

            <!-- Content Area -->
            <div class="ss-content">
                <!-- Overview Tab -->
                <div id="ss-tab-overview" class="ss-tab-pane active">
                    <div class="cs-header">
                        <h2 class="cs-title">Server Overview</h2>
                        <p class="cs-subtitle">Update your server's name and icon.</p>
                    </div>

                    <form id="update-server-form" class="cs-form">
                        <input type="hidden" id="ss-server-id" name="serverId" />
                        
                        <div class="cs-icon-upload-wrap">
                            <label for="ss-icon-input" class="cs-icon-upload">
                                <img id="ss-icon-preview" class="cs-icon-preview" hidden />
                                <div id="ss-icon-placeholder" class="cs-icon-placeholder">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                                    <span>Upload</span>
                                </div>
                            </label>
                            <input type="file" id="ss-icon-input" name="serverIcon" class="cs-icon-file-input" accept="image/*" />
                        </div>

                        <div class="cs-field">
                            <label class="cs-label">Server Name <span class="cs-required">*</span></label>
                            <input type="text" id="ss-server-name" name="serverName" class="cs-input" required />
                        </div>

                        <div class="cs-actions">
                            <button type="submit" class="cs-btn cs-btn--primary">Save Changes</button>
                        </div>
                    </form>
                </div>

                <!-- Roles Tab -->
                <div id="ss-tab-roles" class="ss-tab-pane">
                    <div class="cs-header ss-roles-header">
                        <div>
                            <h2 class="cs-title">Roles</h2>
                            <p class="cs-subtitle">Use roles to group your server members and assign permissions.</p>
                        </div>
                        <button class="cs-btn cs-btn--primary cs-btn--small" onclick="createNewRole()">Create Role</button>
                    </div>

                    <div class="ss-roles-layout">
                        <div class="ss-roles-list" id="roles-list-container">
                            <!-- Roles will be loaded here -->
                        </div>
                        <div class="ss-role-edit" id="role-edit-container" style="display: none;">
                            <form id="edit-role-form" class="cs-form">
                                <input type="hidden" id="edit-role-id" name="roleId" />
                                <div class="cs-field">
                                    <label class="cs-label">Role Name</label>
                                    <input type="text" id="edit-role-name" name="name" class="cs-input" required />
                                </div>
                                <div class="cs-field">
                                    <label class="cs-label">Role Color</label>
                                    <input type="color" id="edit-role-color" name="color" class="cs-input cs-input--color" />
                                </div>
                                <div class="cs-field">
                                    <label class="cs-label">Permissions</label>
                                    <div class="permissions-list" id="permissions-list">
                                        <!-- Permissions checkboxes will be here -->
                                    </div>
                                </div>
                                <div class="cs-actions">
                                    <button type="button" class="cs-btn cs-btn--danger cs-btn--small" onclick="deleteCurrentRole()">Delete Role</button>
                                    <button type="submit" class="cs-btn cs-btn--primary">Save Role</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Members Tab -->
                <div id="ss-tab-members" class="ss-tab-pane">
                    <div class="cs-header">
                        <h2 class="cs-title">Server Members</h2>
                        <p class="cs-subtitle">Manage the members of your server and their roles.</p>
                    </div>
                    <div class="ss-members-list" id="members-list-container">
                        <!-- Members will be loaded here -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="invite-modal" class="cs-backdrop">
    <div class="cs-modal">
        <button class="cs-close-btn" onclick="closeInviteModal()">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>

        <div class="cs-header">
            <h2 class="cs-title">Invite friends to this server</h2>
            <p class="cs-subtitle">Share this link with others to grant them access.</p>
        </div>

        <div class="cs-form">
            <div class="cs-field">
                <label class="cs-label">Invite Link</label>
                <div style="display: flex; gap: 8px;">
                    <input type="text" id="invite-link-input" class="cs-input" readonly value="" />
                    <button type="button" class="cs-btn cs-btn--primary" onclick="copyInviteLink()">Copy</button>
                </div>
                <p class="cs-help-text">Your invite link never expires.</p>
            </div>
        </div>
    </div>
</div>

