<!-- ═══════════════════════════════════════════════════════
     Create Server Modal
     Wire up open/close and form submission yourself in JS.
     Trigger open: document.getElementById('create-server-modal').classList.add('open')
     Trigger close: document.getElementById('create-server-modal').classList.remove('open')
     ═══════════════════════════════════════════════════════ -->
<div id="create-server-modal" class="cs-backdrop" role="dialog" aria-modal="true" aria-labelledby="cs-title">

    <div class="cs-modal">

        <!-- Close button -->
        <button id="cs-close-btn" class="cs-close-btn" type="button" aria-label="Close">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="18" y1="6" x2="6" y2="18"/>
                <line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
        </button>

        <!-- ── Step 1: Choose type ──────────────────────────── -->
        <div id="cs-step-type" class="cs-step cs-step--active">

            <div class="cs-header">
                <h2 id="cs-title" class="cs-title">Create a server</h2>
                <p class="cs-subtitle">
                    Your server is where you and your friends hang out. Make yours and start talking.
                </p>
            </div>

            <div class="cs-type-list">
                <button class="cs-type-option" id="cs-type-own" type="button" data-type="own">
                    <span class="cs-type-icon" aria-hidden="true">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                            <circle cx="9" cy="7" r="4"/>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                        </svg>
                    </span>
                    <span class="cs-type-label">Create My Own</span>
                    <span class="cs-type-chevron" aria-hidden="true">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 18 15 12 9 6"/>
                        </svg>
                    </span>
                </button>

                <div class="cs-type-divider">
                    <span>Start from a template</span>
                </div>

                <button class="cs-type-option" id="cs-type-gaming" type="button" data-type="gaming">
                    <span class="cs-type-icon" aria-hidden="true">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="6" width="20" height="14" rx="3"/>
                            <path d="M12 6V3"/>
                            <path d="M8 10h4m-2-2v4"/>
                            <circle cx="16" cy="12" r="1" fill="currentColor"/>
                            <circle cx="18" cy="14" r="1" fill="currentColor"/>
                        </svg>
                    </span>
                    <span class="cs-type-label">Gaming</span>
                    <span class="cs-type-chevron" aria-hidden="true">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 18 15 12 9 6"/>
                        </svg>
                    </span>
                </button>

                <button class="cs-type-option" id="cs-type-school" type="button" data-type="school">
                    <span class="cs-type-icon" aria-hidden="true">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
                            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
                        </svg>
                    </span>
                    <span class="cs-type-label">School Club</span>
                    <span class="cs-type-chevron" aria-hidden="true">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 18 15 12 9 6"/>
                        </svg>
                    </span>
                </button>

                <button class="cs-type-option" id="cs-type-friends" type="button" data-type="friends">
                    <span class="cs-type-icon" aria-hidden="true">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                        </svg>
                    </span>
                    <span class="cs-type-label">Friends</span>
                    <span class="cs-type-chevron" aria-hidden="true">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 18 15 12 9 6"/>
                        </svg>
                    </span>
                </button>

                <button class="cs-type-option" id="cs-type-art" type="button" data-type="art">
                    <span class="cs-type-icon" aria-hidden="true">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M8 12s1.5 2 4 2 4-2 4-2"/>
                            <line x1="9" y1="9" x2="9.01" y2="9"/>
                            <line x1="15" y1="9" x2="15.01" y2="9"/>
                        </svg>
                    </span>
                    <span class="cs-type-label">Artists &amp; Creators</span>
                    <span class="cs-type-chevron" aria-hidden="true">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 18 15 12 9 6"/>
                        </svg>
                    </span>
                </button>
            </div>

            <div class="cs-footer-hint">
                <span>Have an invite already?</span>
                <button class="cs-link-btn" id="cs-join-btn" type="button">Join a Server</button>
            </div>

        </div>

        <!-- ── Step 2: Customise server ──────────────────────── -->
        <div id="cs-step-customize" class="cs-step">

            <button id="cs-back-btn" class="cs-back-btn" type="button" aria-label="Back">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="15 18 9 12 15 6"/>
                </svg>
            </button>

            <div class="cs-header">
                <h2 class="cs-title">Customise your server</h2>
                <p class="cs-subtitle">
                    Give your new server a personality with a name and an icon.<br>
                    You can always change it later.
                </p>
            </div>

            <form id="create-server-form" class="cs-form" method="post" enctype="multipart/form-data"
                  novalidate>
                @Html.AntiForgeryToken()

                <!-- Server icon upload -->
                <div class="cs-icon-upload-wrap">
                    <label for="cs-icon-input" class="cs-icon-upload" id="cs-icon-label"
                           title="Upload a server icon" aria-label="Upload server icon">
                        <span class="cs-icon-placeholder" id="cs-icon-placeholder">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round" aria-hidden="true">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                                <polyline points="17 8 12 3 7 8"/>
                                <line x1="12" y1="3" x2="12" y2="15"/>
                            </svg>
                            <span>UPLOAD</span>
                        </span>
                        <img id="cs-icon-preview" class="cs-icon-preview" src="" alt="Server icon preview"
                             hidden />
                    </label>
                    <input type="file" id="cs-icon-input" name="serverIcon" accept="image/*"
                           class="cs-icon-file-input" aria-label="Upload server icon file" />
                </div>

                <!-- Server name -->
                <div class="cs-field">
                    <label class="cs-label" for="cs-server-name">
                        SERVER NAME <span class="cs-required" aria-hidden="true">*</span>
                    </label>
                    <input
                        type="text"
                        id="cs-server-name"
                        name="serverName"
                        class="cs-input"
                        placeholder="My Awesome Server"
                        maxlength="100"
                        required
                        autocomplete="off"
                        aria-required="true"
                    />
                    <span class="cs-input-hint" id="cs-name-hint" aria-live="polite"></span>
                </div>

                <!-- Hidden: server type carried from step 1 -->
                <input type="hidden" id="cs-server-type" name="serverType" value="" />

                <p class="cs-terms">
                    By creating a server, you agree to Miscord's
                    <a href="#" class="cs-link">Community Guidelines</a>.
                </p>

                <div class="cs-actions">
                    <button class="cs-btn cs-btn--ghost" id="cs-cancel-btn" type="button">Back</button>
                    <button class="cs-btn cs-btn--primary" id="cs-submit-btn" type="submit">
                        Create Server
                    </button>
                </div>

            </form>

        </div>

    </div>
</div>
