@using Microsoft.AspNetCore.Identity
@inject UserManager<Miscord.Data.Models.ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="en-GB" class="platform-web theme-dark theme-darker images-dark density-default font-size-16 no-webkit-scrollbar mouse-mode full-motion app-focused visual-refresh mana-toggle-inputs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gurimilishi</title>
    <link rel="icon" type="image/png" href="/gurimilishi.png" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/discord-exact.css" asp-append-version="true" />
</head>
<body>
<div id="app-mount">
    @if (User.Identity?.IsAuthenticated ?? false)
    {
        <div class="app-container">

            <!-- 1. Server Sidebar -->
            @await Component.InvokeAsync("ServerSidebar")

            <!-- 2. Channel Sidebar -->
            <aside class="channel-sidebar">

                <div class="sidebar-header-dropdown" id="server-header-dropdown" style="@(ViewData["Server"] == null ? "display:none;" : "")">
                    <header class="sidebar-header" onclick="toggleServerDropdown()">
                        <span class="sidebar-header-name">@(ViewData["ServerName"] ?? "Gurimilishi")</span>
                        <svg id="header-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:#80848e;flex-shrink:0;transition: transform 0.2s;">
                            <polyline points="6 9 12 15 18 9"/>
                        </svg>
                    </header>
                    <div class="server-dropdown-menu" id="server-dropdown-menu">
                        <div class="dropdown-item" id="server-settings-dropdown-item" onclick="openServerSettingsModal()" style="display:none;">
                            <span>Server Settings</span>
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1-2 2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                        </div>
                        <div class="dropdown-item invite" onclick="openInviteModal()">
                            <span>Invite People</span>
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="17" y1="11" x2="23" y2="11"/></svg>
                        </div>
                        <div class="ss-divider"></div>
                        <div class="dropdown-item ss-tab--danger" id="leave-server-dropdown-item" onclick="leaveServer()" style="display:none;">
                            <span>Leave Server</span>
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                        </div>
                    </div>
                </div>

                <div class="channel-list">
                    @if (ViewData["Server"] is Miscord.Data.Models.Server server)
                    {
                        <partial name="~/Views/Server/_ChannelList.cshtml" model="server" />
                    }
                    else
                    {
                        <p class="channel-list-placeholder">Select a server to view channels.</p>
                    }
                </div>

                <!-- User Panel -->
                @{
                    var currentUser = await UserManager.GetUserAsync(User);
                    var displayName = currentUser?.Nickname ?? currentUser?.UserName ?? "Unknown";
                    var userColor = AvatarHelper.GetUserColor(displayName);
                }
                <div class="user-panel">
                    <input type="hidden" id="current-user-id" value="@currentUser?.Id" />
                    <input type="hidden" id="current-user-name" value="@displayName" />
                    <input type="hidden" id="current-user-pfp" value="@(currentUser?.ProfilePictureData != null ? Convert.ToBase64String(currentUser.ProfilePictureData) : "")" />
                    <div class="user-info">
                        <div class="user-avatar" style="background-color: @(currentUser?.ProfilePictureData == null ? userColor : "transparent")">
                            @if (currentUser?.ProfilePictureData == null)
                            {
                                @displayName.Substring(0, 1).ToUpper()
                            }
                            else
                            {
                                <img src="data:image/png;base64,@Convert.ToBase64String(currentUser.ProfilePictureData)" />
                            }
                            <div class="user-status-dot"></div>
                        </div>
                        <div class="user-details">
                            <div class="user-name">@displayName</div>
                            <div class="user-tag">Online</div>
                        </div>
                    </div>

                    <div class="user-panel-actions">
                        <!-- Mute mic -->
                        <button class="up-btn" title="Mute">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
                                <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
                                <line x1="12" y1="19" x2="12" y2="23"/>
                                <line x1="8" y1="23" x2="16" y2="23"/>
                            </svg>
                        </button>
                        <!-- Deafen headphones -->
                        <button class="up-btn" title="Deafen">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M3 18v-6a9 9 0 0 1 18 0v6"/>
                                <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/>
                            </svg>
                        </button>
                        <!-- User Settings -->
                        <button type="button" class="up-btn" title="User Settings" onclick="openUserSettingsModal()">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="3"/>
                                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1-2 2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                            </svg>
                        </button>
                    </div>
                </div>
            </aside>

            <!-- 3. Main Content -->
            <main class="main-content">
                @RenderBody()
            </main>

        </div>
        <partial name="~/Views/Server/_CreateServerModal.cshtml" />
        <partial name="~/Views/Server/_ServerSettingsModal.cshtml" />
        <partial name="~/Views/Shared/_UserSettingsModal.cshtml" />

        <!-- Reusable Discord-style Prompt Modal -->
        <div id="discord-prompt-modal" class="cs-backdrop" role="dialog" aria-modal="true">
            <div class="cs-modal" style="max-width: 440px; padding: 24px;">
                <div class="cs-header" style="text-align: left; padding: 0 0 16px;">
                    <h2 class="cs-title" id="dpm-title">Prompt</h2>
                    <p class="cs-subtitle" id="dpm-subtitle"></p>
                </div>
                <div class="cs-field">
                    <label class="cs-label" id="dpm-label"></label>
                    <input type="text" id="dpm-input" class="cs-input" autocomplete="off" />
                </div>
                <div class="cs-actions" style="margin-top: 24px; justify-content: flex-end; gap: 8px;">
                    <button class="cs-btn cs-btn--ghost" onclick="closeDiscordPrompt(false)">Cancel</button>
                    <button class="cs-btn cs-btn--primary" id="dpm-confirm-btn" onclick="closeDiscordPrompt(true)">Done</button>
                </div>
            </div>
        </div>

        <!-- Reusable Discord-style Alert Modal -->
        <div id="discord-alert-modal" class="cs-backdrop" role="dialog" aria-modal="true">
            <div class="cs-modal" style="max-width: 440px; padding: 24px;">
                <div class="cs-header" style="text-align: left; padding: 0 0 16px;">
                    <h2 class="cs-title" id="dam-title">Notice</h2>
                </div>
                <p class="cs-subtitle" id="dam-message" style="margin-bottom: 24px;"></p>
                <div class="cs-actions" style="justify-content: flex-end;">
                    <button class="cs-btn cs-btn--primary" onclick="closeDiscordAlert()">Okay</button>
                </div>
            </div>
        </div>

        <div id="toast-container" class="toast-container"></div>

        <script>
            document.addEventListener('DOMContentLoaded', function() {
                @if (TempData["Message"] != null)
                {
                    <text>showToast('@TempData["Message"]', 'success');</text>
                }
                @if (TempData["Error"] != null)
                {
                    <text>showToast('@TempData["Error"]', 'error');</text>
                }
            });

            function showToast(message, type = 'info') {
                const container = document.getElementById('toast-container');
                const toast = document.createElement('div');
                toast.className = `toast toast--${type}`;
                toast.innerText = message;
                container.appendChild(toast);

                setTimeout(() => {
                    toast.classList.add('toast--visible');
                    setTimeout(() => {
                        toast.classList.remove('toast--visible');
                        setTimeout(() => toast.remove(), 300);
                    }, 4000);
                }, 100);
            }
        </script>

        <style>
            .toast-container {
                position: fixed;
                top: 20px;
                right: 20px;
                z-index: 10000;
                display: flex;
                flex-direction: column;
                gap: 10px;
            }
            .toast {
                background: #313338;
                color: #fff;
                padding: 12px 20px;
                border-radius: 8px;
                box-shadow: 0 4px 15px rgba(0,0,0,0.3);
                font-size: 14px;
                font-weight: 500;
                transform: translateX(120%);
                transition: transform 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55);
                border-left: 4px solid #5865f2;
            }
            .toast--visible {
                transform: translateX(0);
            }
            .toast--success { border-left-color: #23a55a; }
            .toast--error { border-left-color: #f23f43; }
        </style>
    }
    else
    {
        <div class="auth-bg">
            @RenderBody()
        </div>
    }
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
