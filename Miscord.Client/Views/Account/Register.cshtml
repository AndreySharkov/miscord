@model Miscord.Client.Models.RegisterViewModel

@{
    ViewData["Title"] = "Create an account";
}

<div class="auth-container">
    <h2 style="text-align: center;">Create an account</h2>

    <form asp-controller="Account" asp-action="Register" method="post" style="margin-top: 20px;">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="form-group">
            <label asp-for="Email">Email</label>
            <input asp-for="Email" class="form-control-discord" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Username">Username</label>
            <input asp-for="Username" class="form-control-discord" autocomplete="username" />
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Password">Password</label>
            <input asp-for="Password" type="password" class="form-control-discord" autocomplete="new-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="ConfirmPassword">Confirm Password</label>
            <input asp-for="ConfirmPassword" type="password" class="form-control-discord" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <button type="submit" class="btn-discord">Continue</button>

        <p class="auth-link-text">
            <a asp-action="Login" class="auth-link">Already have an account?</a>
        </p>

        <p style="font-size: 12px; color: #949ba4; margin-top: 12px; line-height: 1.4;">
            By registering, you agree to Miscord's <a href="#" class="auth-link">Terms of Service</a> and <a href="#" class="auth-link">Privacy Policy</a>.
        </p>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
